{
  "name": "@him666233/dsh-inline-diff",
  "version": "1.3.0",
  "description": "Inline diff cards for DSH: per-edit diffs, automatic file-language detection with syntax highlighting (red/green-safe palette), expanded command/generic/search/web rows, read ranges, and a side-by-side viewer. Works in desktop and Web UI profiles.",
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": {
    "name": "Him666233",
    "url": "https://github.com/Him666233"
  },
  "homepage": "https://github.com/Him666233/dsh-inline-diff#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Him666233/dsh-inline-diff.git"
  },
  "bugs": {
    "url": "https://github.com/Him666233/dsh-inline-diff/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "diff",
    "inline-diff",
    "plugin",
    "syntax-highlighting",
    "language-detection"
  ]
}
